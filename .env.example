# Kopioi tämä tiedostoksi .env ja täytä arvot Azure AI Foundrysta.
# .env on .gitignoressa – älä koskaan commitoi oikeita avaimia.

# Foundry-resurssin endpoint, esim. https://<resurssin-nimi>.openai.azure.com/
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21

# Deploymenttien NIMET (ne nimet, jotka annoit Foundryssa käyttöönoton yhteydessä)
CHAT_DEPLOYMENT=gpt-4.1-mini
EMBEDDING_DEPLOYMENT=text-embedding-3-small
# Valinnainen: tuomarina eri malli kuin agenttina, esim. gpt-4.1 (tyhjä = sama kuin CHAT_DEPLOYMENT)
JUDGE_DEPLOYMENT=

# Hinnat kustannusseurantaa varten, USD / 1M tokenia (tarkista ajantasaiset hinnat Azuresta)
PRICE_INPUT_PER_M=0.40
PRICE_OUTPUT_PER_M=1.60
